<?xml version="1.0"?>
<!--
  雲台 (pantilt0) のモデル。手書きの SDF の例 (OpenJUIZ/juiz#385)。
  単位はメートル、x 前・y 左・z 上 (juiz と同じなので up_axis は書かない)。
  <pose> は x y z roll pitch yaw (m, rad)。原点は台車に取り付ける面の中心で、pan0 がこの原点の z 軸まわりに回す。
  カメラ (camera0) は conf の Transform で雲台の (0.05, 0, 0.02) に付き、頭の前に来る。
-->
<sdf version="1.9">
  <model name="pantilt">
    <link name="body">
      <!-- 台座の円盤。<material> を書かないので、conf の model.color で塗られる -->
      <visual name="base">
        <pose>0 0 0.0025 0 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.005</length></cylinder></geometry>
      </visual>
      <!-- 首。パンで一緒に回る -->
      <visual name="neck">
        <pose>0 0 0.0075 0 0 0</pose>
        <geometry><cylinder><radius>0.015</radius><length>0.005</length></cylinder></geometry>
        <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <!-- 頭。前 (+x) の面にカメラが付く -->
      <visual name="head">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry><box><size>0.07 0.06 0.03</size></box></geometry>
        <material><diffuse>0.95 0.45 0.10 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
